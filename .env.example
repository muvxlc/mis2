# App Configuration
NODE_ENV=production
PORT=3000

# MariaDB Configuration
MYSQL_ROOT_PASSWORD=replace-with-a-strong-root-password
MYSQL_DATABASE=mis_db
MYSQL_USER=mis_user
MYSQL_PASSWORD=replace-with-a-strong-database-password
MYSQL_PORT=3306

# Redis Configuration
REDIS_PASSWORD=replace-with-a-strong-redis-password
REDIS_PORT=6379

# JWT Secret (IMPORTANT: Change in production!)
JWT_SECRET=replace-with-at-least-32-random-characters

# Initial admin (used only when the admin account does not exist)
ADMIN_PASSWORD=replace-with-at-least-12-random-characters

# ThaiID OAuth Configuration
THAID_CLIENT_ID=your_thaid_client_id
THAID_CLIENT_SECRET=your_thaid_client_secret
THAID_REDIRECT_URI=http://localhost:3000/api/auth/thaid/callback

# Docker Port Configuration
APP_PORT=3000
NGINX_HTTP_PORT=80
NGINX_HTTPS_PORT=443
